@startuml Spield_Overview
skinparam componentStyle rectangle
skinparam defaultTextAlignment center
skinparam linetype ortho
skinparam ranksep 60
skinparam nodesep 40

skinparam package {
  BorderColor      #888780
  BorderThickness  1.5
  FontColor        #3A3A3A
  FontSize         12
  FontStyle        bold
  BackgroundColor  transparent
}
skinparam component {
  BorderThickness  1.3
  FontSize         12
  FontColor        #1A1A1A
}
skinparam arrow {
  FontSize  10
  Color     #555550
  Thickness 1.4
}
skinparam actor {
  BorderColor #888780
  FontSize    11
}
skinparam note {
  BackgroundColor #FFFBEE
  BorderColor     #E0A020
  FontSize        10
}

title Spield v2 — System Overview (Stellar / Soroban)

' ============ ACTORS ============
actor "Admin /\nGovernance"        as Admin  #FFFFFF
actor "Saver\n(Fixed Rate)"        as Saver  #FFFFFF
actor "Yield Trader\n(PT / YT)"    as Trader #FFFFFF
actor "LP Provider"                as LP     #FFFFFF

' ============ TIER 0: OFF-CHAIN ============
package "Off-chain" {
  [Frontend\n(React / Vite +\nFreighter Wallet)] as Frontend #F5F4F2
  [Solvency\nWatchtower\n(alerts only)] as Watch #F5F4F2
}

' ============ TIER 1: GOVERNANCE ============
package "Governance & Control Plane" {
  [Admin Module\npropose / accept admin]     as AdminMod  #EEEDFE
  [Upgrade Manager\nschedule / apply / cancel\n(timelocked)]          as Upgrade   #EEEDFE
  [Pause Authority\nblocks inflows only;\nexits always open]          as Pause     #EEEDFE
  [Maturity Controller\nlive > at_maturity > settled] as Maturity  #EEEDFE
  [Init Guard\none-shot per contract]        as InitGuard #EEEDFE
}

' ============ TIER 2: PRODUCTS ============
package "Product Layer" {
  [spield-vault\n(Fixed-Rate Flagship)\ndeposit / redeem / seed / harvest] as Vault  #E1F5EE
  [spield-market\n(Time-Decay AMM)\nswap / add_liquidity / remove_liquidity\nimplied_apy / pt_price]    as Market #E1F5EE
}

' ============ TIER 3: ENGINE ============
package "Tokenization Engine  (spield-wrapper)" {
  [mint / claim_yield\nredeem_pt / combine_and_redeem\ntransfer_position / bump_position] as Wrapper #E6F1FB
  [Position Store\n{owner, principal, shares,\nentry_rate, settled_rate, open}] as PosStore #E6F1FB
  [Solvency Invariant\nassertion after every tx] as SolvInv #FAECE7
}

' ============ TIER 3.5: ASSETS ============
package "SAC Assets  (Stellar Asset Contracts)" {
  [PT  (SPLDPT)\n7-decimal\nMint/burn: Wrapper only\nRedeems 1:1 at maturity] as PT   #D0EAF8
  [YT  (SPLDYT)\n7-decimal\nMint/burn: Wrapper only\nClaim settles; does not burn] as YT #D0EAF8
  [USDC  (Stellar native)\n7-decimal\nDeposit, payout, settlement] as USDC #D8F0E8
}

' ============ TIER 4: MATH ============
package "Shared Math  (spield-shared)" {
  [Fixed-Point Library\n12-dp rates | 7-dp tokens\nfixed_mul / fixed_div\nln_approx / exp_approx] as MathLib #FDF5E0
}

' ============ TIER 5: ADAPTER ============
package "Yield Adapter  (spield-strategy)" {
  [Strategy Interface\ndeposit / redeem\ncurrent_rate / position_value] as Strategy #FAEEDA
  [Blend Impl  (Day 1)\nbRate = live yield index\nmax_apr_bps safety bound] as BlendImpl #FAEEDA
}

' ============ TIER 6: EXTERNAL ============
package "External Protocols" {
  [Blend v2  (Lending Market)\nbTokens accrue real interest\nbRate rises as borrowers pay\nSolvency by construction] as Blend #F1EFE8
  [Soroban RPC\nsimulate / send / poll / events] as RPC #F1EFE8
}

' ============ ACTOR FLOWS ============
Admin   --> AdminMod  : admin ops
Admin   --> Upgrade   : schedule / apply upgrade
Admin   --> Pause     : pause / unpause
Saver   --> Frontend  : deposit USDC; redeem at maturity
Trader  --> Frontend  : mint PT+YT; claim; trade; combine
LP      --> Frontend  : add / remove liquidity

' ============ GOVERNANCE ============
Upgrade   ..> Wrapper   : code upgrade (timelocked)
Upgrade   ..> Vault     : code upgrade (timelocked)
Upgrade   ..> Market    : code upgrade (timelocked)
Upgrade   ..> BlendImpl : code upgrade (timelocked)
InitGuard ..> Wrapper   : one-shot init guard
InitGuard ..> Vault     : one-shot init guard
InitGuard ..> Market    : one-shot init guard
Maturity  ..> Market    : disable swaps at maturity
Maturity  ..> Wrapper   : enable PT redemption
Maturity  ..> Vault     : enable receipt payout
Pause     ..> Wrapper   : block mint if paused
Pause     ..> Vault     : block deposit if paused
Pause     ..> Market    : block swaps if paused

' ============ PRODUCT -> ENGINE ============
Vault  ..> Wrapper : seed: authorize mint PT capacity\nclaim_yield: harvest loop
Market --> PT      : holds PT reserve; transfers on swap
Market --> USDC    : holds USDC reserve; transfers on swap

' ============ ENGINE INTERNALS ============
Wrapper --> PosStore : create / update Position
Wrapper --> PT       : mint / burn
Wrapper --> YT       : mint / burn
Wrapper --> USDC     : pay yield / principal
Wrapper ..> SolvInv  : assert after every tx
Wrapper --> MathLib  : fixed_mul / fixed_div
Wrapper --> Strategy : deposit / current_rate / redeem

' ============ AMM MATH ============
Market --> MathLib : ln_approx / pow_approx\n(time-decay curve)

' ============ AUTH CHAIN ============
Vault    ..> Wrapper  : authorize_as_current_contract\n(L2 Vault -> L3 Engine)
Wrapper  ..> Strategy : authenticated cross-contract call\n(L3 Engine -> L4 Adapter)
Strategy ..> Blend    : supply / withdraw USDC\n(L4 Adapter -> L5 Blend)

' ============ ADAPTER ============
Strategy   --> BlendImpl : delegates
BlendImpl  --> Blend     : submit supply / withdraw
BlendImpl  ..> Blend     : read live bRate

' ============ FRONTEND / RPC ============
Frontend ..> RPC : simulateTransaction (free reads)\nsendTransaction + poll
Watch    ..> RPC : poll solvency() view

note right of SolvInv
  position_value(total_shares)
  >= total_principal + unclaimed_yield
  Checked after every mint / claim /
  redeem / combine. Cannot be bypassed.
end note

note right of BlendImpl
  bRate rises only because borrowers
  pay real interest. Cannot be faked.
  Eliminates the v1 single-signer
  oracle trust flaw (SCF finding 3+8).
end note

@enduml
