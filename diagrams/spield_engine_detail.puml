@startuml Spield_Engine_Detail
skinparam componentStyle rectangle
skinparam defaultTextAlignment center
skinparam linetype ortho
skinparam ranksep 55
skinparam nodesep 35

skinparam package {
  BorderColor      #5B8DB8
  BorderThickness  1.5
  FontColor        #2A4A6A
  FontSize         12
  FontStyle        bold
  BackgroundColor  transparent
}
skinparam component {
  BorderThickness  1.3
  FontSize         11
  FontColor        #1A1A1A
}
skinparam arrow {
  FontSize  10
  Color     #444440
  Thickness 1.4
}
skinparam note {
  BackgroundColor #EEF6FF
  BorderColor     #5B8DB8
  FontSize        10
}

title Spield v2 — Tokenization Engine Detail (spield-wrapper)

' ============ ENTRY POINTS ============
package "Public Entry Points" {
  [mint(user, amount)\nreturns position_id\nRequires: user auth\nPulls USDC from user wallet] as MintFn    #D4E8F8
  [claim_yield(position_id)\nreturns usdc_paid\nRequires: position owner auth\nSettles without burning YT] as ClaimFn   #D4E8F8
  [redeem_pt(position_id, amount)\nRequires: now >= maturity_ts\nBurns PT; returns USDC 1:1] as RedeemFn  #D4E8F8
  [combine_and_redeem(position_id, amount)\nAuto-claims yield first\nBurns equal PT + YT; returns USDC] as CombineFn #D4E8F8
  [transfer_position(position_id, to)\nReassigns position to new owner\nentry_rate travels with position] as TransferFn #D4E8F8
  [bump_position(position_id)\nPermissionless TTL extension\nKeeps state alive between uses] as BumpFn    #D4E8F8
}

' ============ POSITION STORE ============
package "Position Store  (Persistent storage — keyed by position_id: u64)" {
  [Position\n{\n  owner:        Address\n  principal:    i128\n  shares:       i128   (Blend bToken shares)\n  entry_rate:   i128   (bRate at mint time)\n  settled_rate: i128   (updated on claim only)\n  open:         bool\n}] as Position #E6F1FB
}

' ============ GLOBAL STATE ============
package "Global State  (Instance storage)" {
  [Wrapper State\n{\n  admin:           Address\n  initialized:     bool\n  maturity_ts:     u64\n  strategy_addr:   Address\n  pt_asset:        Address\n  yt_asset:        Address\n  usdc_asset:      Address\n  total_principal: i128\n  total_shares:    i128\n  paused:          bool\n}] as WrapperState #E6F1FB
}

' ============ SOLVENCY ============
package "Solvency Invariant  (enforced after every state change)" {
  [strategy.position_value(total_shares)\n  is-greater-or-equal-to\n  total_principal + sum(unclaimed_yield)\n\nIf this would be violated -> tx is rejected.\nPublic read: solvency() returns\n  (backing, principal, unclaimed)] as SolvInv #FAECE7
}

' ============ CROSS-CONTRACT DEPS ============
package "Cross-Contract Dependencies" {
  [Strategy Adapter\ncurrent_rate() -> live bRate\ndeposit(amount) -> shares\nredeem(shares) -> USDC\nposition_value(shares) -> USDC] as StratDep #FAEEDA
  [PT SAC  (SPLDPT)\nmint / burn\nWrapper holds admin rights] as PTDep  #D0EAF8
  [YT SAC  (SPLDYT)\nmint / burn\nWrapper holds admin rights] as YTDep  #D0EAF8
  [USDC SAC\ntransfer to user\n(yield payout / principal)] as USDCDep #D8F0E8
  [spield-shared MathLib\nfixed_mul(a, b, 1e12)\nfixed_div(a, b, 1e12)\nclamp_zero(i128)] as MathDep #FDF5E0
}

' ============ MINT FLOW ============
MintFn --> StratDep    : deposit(amount) -> shares\nentry_rate = current_rate()
MintFn --> Position    : create NEW Position\n(never overwrites existing)
MintFn --> WrapperState : +total_principal\n+total_shares
MintFn --> PTDep       : mint(user, amount)
MintFn --> YTDep       : mint(user, amount)
MintFn ..> SolvInv     : assert invariant AFTER mint
MintFn --> MathDep     : rate encoding

' ============ CLAIM FLOW ============
ClaimFn --> StratDep   : current_rate() -> live bRate\nredeem(yield_shares) -> USDC
ClaimFn --> Position   : read entry_rate, settled_rate\nset settled_rate = current_rate\nYT is NOT burned
ClaimFn --> USDCDep    : transfer(yield) to owner
ClaimFn --> MathDep    : yield = fixed_mul(\n  current_rate - settled_rate,\n  YT_amount, 1e12)\nclamp_zero if negative
ClaimFn ..> SolvInv    : assert invariant AFTER claim

' ============ REDEEM PT FLOW ============
RedeemFn --> Position  : check now >= maturity_ts\nmark position closed
RedeemFn --> PTDep     : burn(amount)
RedeemFn --> StratDep  : redeem(principal_shares) -> USDC
RedeemFn --> USDCDep   : transfer(principal) to owner
RedeemFn ..> SolvInv   : assert invariant AFTER redeem

' ============ COMBINE FLOW ============
CombineFn --> ClaimFn  : auto claim_yield first\n(prevents silent yield loss)
CombineFn --> PTDep    : burn(amount)
CombineFn --> YTDep    : burn(amount)
CombineFn --> StratDep : redeem(shares) -> USDC
CombineFn --> USDCDep  : transfer(principal) to owner
CombineFn ..> SolvInv  : assert invariant AFTER combine

' ============ TRANSFER ============
TransferFn --> Position : reassign owner\nentry_rate + settled_rate travel with it\n(prevents phantom-yield exploit)

note right of MintFn
  KEY ACCOUNTING RULES:
  1. Each deposit creates a SEPARATE Position
     with its own entry_rate.
  2. entry_rate is NEVER overwritten on top-up.
     (Fixes SCF finding #4.)
  3. The strategy receives USDC; the bTokens
     are the real, growing backing asset.
end note

note right of ClaimFn
  KEY ACCOUNTING RULES:
  1. claim_yield SETTLES; does NOT burn YT.
     YT keeps accruing until maturity.
     (Fixes SCF finding #6.)
  2. settled_rate advances per claim.
  3. fresh buyer who just received a transferred
     YT cannot claim yield from before they held
     it (entry_rate travels). (Fixes SCF #5.)
end note

note right of SolvInv
  This invariant holds by CONSTRUCTION:
  Blend bTokens physically grow as
  borrowers pay interest. There is no
  invented or pushed index number.
  The backing is REAL.
  (Fixes SCF finding #3 — the fatal flaw.)
end note

@enduml
