+    std::println!("PT price          = {:.6}", w.market().pt_price() as f64 / 1e12);
+    for want in [1_000 * USDC, 10_000 * USDC, 100_000 * USDC] {
+        let (user_in, _) = w.market().quote_buy_yt_exact_out(&want);
+        let fee_on_notional = want * (FEE_BPS as i128) / 10_000;
+        std::println!(
+            "{:>7} YT: user pays {:>10.4} USDC | fee on notional {:>9.4} = {:>6.1}% of what the user pays | leverage {:>6.1}x",
+            want / USDC,
