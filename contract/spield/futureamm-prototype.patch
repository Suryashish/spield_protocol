+#[test]
+fn a_yt_only_position_settles_correctly_at_maturity() {
+    let w = setup(YEAR);
+    deep_pool(&w);
+    let n = 10_000 * USDC;
+    let (user_in, _) = w.market().quote_buy_yt_exact_out(&n);
+    let u = w.new_user(user_in);
+    let pid = w.wrapper().next_position_id();
+    w.market().buy_yt_exact_out(&u, &n, &user_in, &0u32);
+
+    w.advance(300 * 24 * 60 * 60);
+    w.env.cost_estimate().budget().reset_unlimited();
+    let mid = w.wrapper().claim_yield(&pid);
+    assert!(mid > 0);
+
+    // Past maturity: YT stops accruing, and the accrued-but-unclaimed remainder is still payable.
+    w.env.ledger().set_timestamp(w.maturity + 1);
+    w.env.cost_estimate().budget().reset_unlimited();
+    let at_maturity = w.wrapper().claim_yield(&pid);
+    let after = w.wrapper().position_value(&pid).claimable_yield;
+    assert_eq!(after, 0, "nothing more accrues after settlement");
+
+    // ... and it stays zero however long we wait (the maturity rate is stamped once).
+    w.env.ledger().set_timestamp(w.maturity + 90 * 24 * 60 * 60);
+    assert_eq!(w.wrapper().position_value(&pid).claimable_yield, 0);
+    std::println!(
+        "YT-only position: paid {:.4} USDC at 300d + {:.4} at maturity, for a {:.4} entry",
+        mid as f64 / USDC as f64,
+        at_maturity as f64 / USDC as f64,
+        user_in as f64 / USDC as f64
+    );
+
+    // The YT is worthless now but the position is still open — the holder has no principal claim,
+    // which is correct: the PT the pool holds is the principal claim.
+    assert_eq!(w.wrapper().get_position(&pid).pt_amount, 0);
+}
