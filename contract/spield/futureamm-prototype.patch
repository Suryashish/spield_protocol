+        Self::ensure_tradeable(&env);
+        Self::ensure_deadline(&env, deadline_ledger);
+        user.require_auth();
+        if yt_out <= 0 {
+            panic_with_error!(&env, Error::InvalidAmount);
+        }
+
+        let pt_res = storage::pt_reserve(&env);
+        let usdc_res = storage::usdc_reserve(&env);
+        let fee = storage::get_fee_bps(&env);
+        let params = Self::curve_params(&env);
+        // What the pool would pay for `yt_out` PT sold into it — its contribution to the split.
+        let pool_in = curve::swap_pt_for_usdc(&env, yt_out, pt_res, usdc_res, fee, &params)
+            .amount_out;
+        if pool_in <= 0 || pool_in >= yt_out {
+            // A pool contribution >= the notional would mean PT priced at/above par: the user would
+            // be paid to take YT. Refuse rather than mint a free position.
+            panic_with_error!(&env, Error::InsufficientLiquidity);
+        }
+        let user_in = yt_out - pool_in;
+        if user_in > max_usdc_in {
+            panic_with_error!(&env, Error::SlippageExceeded);
+        }
+
+        let me = env.current_contract_address();
+        let usdc = storage::get_underlying(&env);
+        // 1. Pull ONLY the YT price from the user.
+        token::Client::new(&env, &usdc).transfer(&user, &me, &user_in);
+        // 2. Hand the full notional to the wrapper, which mints PT here and YT (+position) to them.
+        let wrapper = storage::get_wrapper(&env);
+        Self::authorize_usdc_pull(&env, &usdc, &wrapper, yt_out);
+        WrapperContractClient::new(&env, &wrapper).split_for_market(&me, &user, &yt_out);
+
+        // 3. Reserves move exactly as if `yt_out` PT had been sold into the pool.
+        storage::set_pt_reserve(&env, pt_res + yt_out);
+        storage::set_usdc_reserve(&env, usdc_res - pool_in);
+        storage::bump_instance(&env);
