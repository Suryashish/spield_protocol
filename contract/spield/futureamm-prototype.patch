+        }
+        if amount > pos.yt_amount {
+            panic_with_error!(&env, Error::InsufficientBalance);
+        }
+
+        // Checkpoint on the OLD amount first (spec §4.5) — never after the reduction.
+        let claimed = Self::do_claim(&env, position_id, &mut pos);
+
+        Self::pt_admin(&env).burn(&market, &amount);
+        Self::yt_admin(&env).burn(&pos.owner, &amount);
+        let strategy = YieldStrategyClient::new(&env, &storage::get_strategy(&env));
+        let burned = strategy.redeem_underlying(&market, &amount);
+
+        pos.yt_amount -= amount;
+        pos.principal -= amount;
+        pos.shares -= burned;
+        if pos.shares < 0 {
