+/// **PROTOTYPE (spec §6.3 / §9)** — exact-OUTPUT pricing on the PT side: how much USDC the pool
+/// must retain in exchange for handing `pt_out` PT out of its reserve.
+///
+/// This is the mirror of [`try_swap_usdc_for_pt`], which is exact-*input*. A YT sale needs the
+/// exact-output form because the PT leg is pinned by the merge: the wrapper burns exactly `pt_out`
+/// PT against exactly `pt_out` YT. Same fixed-point pass on the post-trade proportion; the fee is
+/// still taken on the USDC leg, so the caller's gross input is grossed up by `1/(1-fee)`.
+pub fn try_usdc_in_for_exact_pt(
+    env: &Env,
+    pt_out: i128,
+    pt_reserve: i128,
+    usdc_reserve: i128,
+    fee_bps: u32,
+    p: &CurveParams,
+) -> Result<i128, Error> {
+    if pt_out <= 0 {
+        return Err(Error::InvalidAmount);
+    }
+    if pt_out >= pt_reserve {
+        return Err(Error::InsufficientLiquidity);
+    }
+    let new_pt = pt_reserve - pt_out;
+
+    // Iterate on the post-trade proportion exactly like the exact-input paths do.
+    let mut usdc_after_fee = 0i128;
+    let mut prop_after = try_proportion(env, new_pt, usdc_reserve)?;
+    for _ in 0..3 {
+        let rate = try_exchange_rate(env, prop_after, p)?;
+        usdc_after_fee = fmul(env, pt_out, rate)?;
+        prop_after = try_proportion(env, new_pt, usdc_reserve + usdc_after_fee)?;
+    }
+    // Gross up so that after the fee is skimmed the pool still nets `usdc_after_fee`.
+    // ceil-divide: the pool must never be short.
+    let keep = (10_000 - fee_bps as i128).max(1);
+    let gross = usdc_after_fee
+        .checked_mul(10_000)
+        .ok_or(Error::MathOverflow)?;
+    let usdc_in = (gross + keep - 1) / keep;
+    if usdc_in <= 0 {
+        return Err(Error::InvalidAmount);
+    }
+    Ok(usdc_in)
 }
