+#[test]
+fn repeated_yt_buying_raises_the_price_and_eventually_the_band_refuses() {
+    let w = setup(YEAR);
+    seed_pool(&w, 12_000 * USDC, 10_000 * USDC); // deliberately shallow
+    let n = 2_000 * USDC;
+    let mut round = 0;
+    loop {
+        let (user_in, pool_in) = w.market().quote_buy_yt_exact_out(&n);
+        if user_in == 0 {
+            std::println!("round {round}: NO QUOTE — pool refuses further YT buys");
+            break;
+        }
+        let (pt_res, usdc_res) = w.market().reserves();
+        std::println!(
+            "round {round}: {} YT costs {:.4} USDC (pool adds {:.2}); reserves PT {:.0} / USDC {:.0}",
+            n / USDC,
+            user_in as f64 / USDC as f64,
+            pool_in as f64 / USDC as f64,
+            pt_res as f64 / USDC as f64,
+            usdc_res as f64 / USDC as f64
+        );
+        let u = w.new_user(user_in);
+        // The band / liquidity check may reject before the quote goes to zero — that is the
+        // "insufficient early-trading liquidity" condition, and it must be a clean refusal.
+        let r = w.market().try_buy_yt_exact_out(&u, &n, &user_in, &0u32);
+        if r.is_err() {
+            std::println!("round {round}: trade REFUSED by the pool (clean revert)");
+            break;
+        }
+        round += 1;
+        assert!(round < 40, "pool never refused — unbounded drain");
+    }
+    assert!(round > 0, "at least one buy must succeed");
+    // Nothing was liquidated: every earlier buyer still holds their YT.
+    let (backing, principal, _) = w.wrapper().solvency();
+    assert!(backing + (w.wrapper().open_positions() as i128) >= principal);
+}
