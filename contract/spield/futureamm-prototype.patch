+/// **The feedback loop.** Opening the pool at a target implied APY requires a very PT-heavy seed
+/// (`seed_pt_for_apy`), and every PT in that seed is a real USDC deposit into Blend. If the seed is
+/// large relative to the Blend pool it floods it, collapses utilization, and destroys the very
+/// realized yield the YT is a claim on.
+#[test]
+fn the_seed_needed_to_open_the_curve_floods_blend_and_kills_the_yield_it_sells() {
+    // A: no market seed at all — just a lone depositor.
+    let a = setup(2 * YEAR);
+    let ha = a.new_user(100_000 * USDC);
+    let pa = a.wrapper().mint(&ha, &(100_000 * USDC));
+
+    // B: identical depositor, but an 8%-calibrated 1M-USDC-side pool is seeded first.
+    let b = setup(2 * YEAR);
+    let usdc_side = 1_000_000 * USDC;
+    let pt_side = b.market().seed_pt_for_apy(&usdc_side, &800u32);
+    seed_pool(&b, pt_side, usdc_side);
+    let hb = b.new_user(100_000 * USDC);
+    let pb = b.wrapper().mint(&hb, &(100_000 * USDC));
+
+    for _ in 0..12 {
+        a.advance(30 * 24 * 60 * 60);
+        b.advance(30 * 24 * 60 * 60);
+    }
+    a.env.cost_estimate().budget().reset_unlimited();
+    b.env.cost_estimate().budget().reset_unlimited();
+    let ya = a.wrapper().position_value(&pa).claimable_yield;
+    let yb = b.wrapper().position_value(&pb).claimable_yield;
+
+    std::println!(
+        "seed required to open at 8%: {:.0} PT ( = {:.0} USDC deposited into Blend)",
+        pt_side as f64 / USDC as f64,
+        pt_side as f64 / USDC as f64
+    );
+    std::println!(
+        "1-year realized yield on a 100k deposit:  no seed {:>9.2} USDC ({:.3}%)   |   with seed {:>9.2} USDC ({:.3}%)",
+        ya as f64 / USDC as f64,
+        ya as f64 * 100.0 / (100_000 * USDC) as f64,
+        yb as f64 / USDC as f64,
+        yb as f64 * 100.0 / (100_000 * USDC) as f64
+    );
+    assert!(yb < ya / 10, "the seed must visibly crush realized yield: {ya} -> {yb}");
+}
