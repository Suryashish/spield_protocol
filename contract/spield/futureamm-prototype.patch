+#[test]
+fn yt_trades_fit_the_mainnet_per_transaction_budget() {
+    let w = setup(YEAR);
+    deep_pool(&w);
+    let n = 10_000 * USDC;
+
+    // Baseline: an ordinary PT swap (no wrapper, no Blend).
+    let seller = w.new_user(1_000 * USDC);
+    w.mint_position(&seller, 1_000 * USDC);
+    w.env.cost_estimate().budget().reset_unlimited();
+    w.market().swap_exact_pt_for_usdc(&seller, &(100 * USDC), &0i128);
+    cost(&w, "swap_exact_pt_for_usdc");
+
+    // Quote AFTER the baseline swap, so the price is live.
+    let (user_in, _) = w.market().quote_buy_yt_exact_out(&n);
+    let u = w.new_user(user_in);
+    let pid = w.wrapper().next_position_id();
+
+    // BUY YT: market -> wrapper -> Blend supply (one Blend submit).
+    w.env.cost_estimate().budget().reset_unlimited();
+    w.market().buy_yt_exact_out(&u, &n, &user_in, &0u32);
+    cost(&w, "buy_yt_exact_out");
+
+    w.advance(180 * 24 * 60 * 60);
+
+    // SELL YT: market -> wrapper -> claim (Blend withdraw #1) + principal (Blend withdraw #2).
+    let (q, _) = w.market().quote_sell_yt_exact_in(&(n / 2));
+    w.env.cost_estimate().budget().reset_unlimited();
+    w.market().sell_yt_exact_in(&u, &pid, &(n / 2), &q, &0u32);
+    cost(&w, "sell_yt_exact_in (partial)");
+
+    let r = w.env.cost_estimate().resources();
+    assert!(r.mem_bytes < MAINNET_MEM_BYTES, "sell_yt must fit mainnet memory");
+    assert!(r.instructions < MAINNET_INSTRUCTIONS, "sell_yt must fit mainnet instructions");
+    assert!(r.write_entries <= MAINNET_WRITE_ENTRIES);
+    assert!(r.write_bytes <= MAINNET_WRITE_BYTES);
+}
