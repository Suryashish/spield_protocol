+        storage::set_total_principal(&env, storage::total_principal(&env) + amount);
+        storage::inc_open_positions(&env);
+        storage::bump_instance(&env);
+
+        events::minted(&env, &yt_recipient, id, amount, entry_rate);
+        Self::assert_solvent(&env);
