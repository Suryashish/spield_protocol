+// ===========================================================================
+// PENDLE COMPARISON — Pendle charges `feeRate = exp(lnFeeRateRoot * yearsToExpiry)` on the
+// EXCHANGE RATE, so the fee shrinks with time to maturity in step with the yield being traded.
+// Spield charges a flat bps on the NOTIONAL, which does not shrink.
+//
+// We reproduce Pendle's fee exactly by computing its effective bps for each term and feeding it
+// through the existing fee machinery: effective_bps = 10_000 * (1 - exp(ln(1-F) * yearsToExpiry)).
+// (Pendle applies it multiplicatively on the rate; to first order that is the same thing.)
+// ===========================================================================
+
+/// `10_000 * (1 - (1-F)^t)` — Pendle's time-scaled fee, in bps, for an annual root `f_root_bps`.
+fn pendle_effective_bps(f_root_bps: u32, days: u64) -> u32 {
+    let t = days as f64 / 365.0;
+    let one_minus_f = 1.0 - (f_root_bps as f64 / 10_000.0);
+    let fee_rate = one_minus_f.powf(t);
+    ((1.0 - fee_rate) * 10_000.0).round() as u32
+}
+
+#[test]
+fn pendle_time_scaled_fee_vs_spield_flat_fee() {
+    const DAY: u64 = 24 * 60 * 60;
+    const F_ROOT: u32 = 100; // 1.00% annualized root
+
+    std::println!(
+        "{:<8} | {:<34} | {:<34}",
+        "term", "SPIELD  flat 30 bps on notional", "PENDLE  1%/yr root, time-scaled"
+    );
+    std::println!("{}", "-".repeat(84));
+
+    for days in [90u64, 180, 365] {
+        let mut row = std::vec::Vec::new();
+        for (tag, fee) in [("spield", 30u32), ("pendle", pendle_effective_bps(F_ROOT, days))] {
+            let w = setup(days * DAY);
+            w.market().set_fee(&fee);
+            let usdc_side = 1_000_000 * USDC;
+            let pt_side = w.market().seed_pt_for_apy(&usdc_side, &500u32);
+            seed_pool(&w, pt_side, usdc_side);
+            let n = 10_000 * USDC;
+            let (buy, _) = w.market().quote_buy_yt_exact_out(&n);
+            let (sell, _) = w.market().quote_sell_yt_exact_in(&n);
+            let rt = if buy > 0 { (buy - sell) as f64 * 100.0 / buy as f64 } else { 0.0 };
+            row.push((tag, fee, buy, sell, rt));
+        }
+        std::println!(
+            "{:>4}d    | fee {:>3}bps  buy {:>7.2}  rt {:>5.1}%       | fee {:>3}bps  buy {:>7.2}  rt {:>5.1}%",
+            days,
+            row[0].1, row[0].2 as f64 / USDC as f64, row[0].4,
+            row[1].1, row[1].2 as f64 / USDC as f64, row[1].4,
+        );
+    }
+    std::println!("\n  Spield's round-trip cost EXPLODES as the term shortens; Pendle's stays flat.");
+}
+
+/// The same comparison against a FEE-INDEPENDENT denominator: the fair YT value read straight
+/// off the curve (`1 - pt_price`), so the two fee models are measured on the same basis.
+///
+/// Pendle's ratio is CONSTANT across maturities by construction; Spield's explodes as the term
+/// shortens. That shape difference — not the level — is the real finding.
+#[test]
+fn fee_as_a_fraction_of_the_yield_being_traded() {
+    const DAY: u64 = 24 * 60 * 60;
+    std::println!(
+        "{:<6} {:>12} {:>14} {:>14} {:>14} {:>14}",
+        "term", "fair YT/10k", "SPIELD 30bps", "PENDLE 1%/yr", "PENDLE 0.5%/yr", "PENDLE 0.25%/yr"
+    );
+    for days in [30u64, 90, 180, 365] {
+        let w = setup(days * DAY);
+        let usdc_side = 1_000_000 * USDC;
+        let pt_side = w.market().seed_pt_for_apy(&usdc_side, &500u32);
+        seed_pool(&w, pt_side, usdc_side);
+        // Fair YT value = (1 - PT price) x notional, straight off the curve. No fee in it.
+        let pt_price = w.market().pt_price();
+        let n = 10_000 * USDC;
+        let fair_yt = (n as f64) * (1e12 - pt_price as f64) / 1e12;
+        let pct = |bps: u32| (n * bps as i128 / 10_000) as f64 * 100.0 / fair_yt;
+        std::println!(
+            "{:>4}d  {:>12.2} {:>13.1}% {:>13.1}% {:>13.1}% {:>13.1}%",
+            days,
+            fair_yt / USDC as f64,
+            pct(30),
+            pct(pendle_effective_bps(100, days)),
+            pct(pendle_effective_bps(50, days)),
+            pct(pendle_effective_bps(25, days)),
+        );
+    }
+    std::println!("\n  PENDLE columns are flat down the column. The SPIELD column is not.");
+}
+
+/// **Why Spield needs a 7:1 seed and Pendle does not.** Spield pins `rate_anchor` at PAR (1.0),
+/// so the entire PT discount has to come from the `ln(p/(1-p))` term — which needs an extreme
+/// PT-heavy pool. Pendle sets `initialAnchor` NEAR the expected PT price instead, so a nearly
+/// balanced pool already prices PT at a discount.
+///
+/// This sweeps the anchor to show the seed requirement collapse.
+#[test]
+fn moving_the_anchor_off_par_collapses_the_seed_requirement() {
+    const DAY: u64 = 24 * 60 * 60;
+    const SC12: i128 = 1_000_000_000_000;
+    std::println!("{:<28} {:>14} {:>12}", "anchor (USDC per PT)", "PT:USDC seed", "PT price");
+    for (label, anchor) in [
+        ("1.0000  (par - today)", SC12),
+        ("0.9950", SC12 * 995 / 1000),
+        ("0.9900", SC12 * 99 / 100),
+        ("0.9880  (~fair at 90d/5%)", SC12 * 988 / 1000),
+    ] {
+        // Fresh world with a custom anchor.
+        let w = setup_with_anchor(90 * DAY, anchor);
+        let usdc_side = 1_000_000 * USDC;
+        let pt_side = w.market().seed_pt_for_apy(&usdc_side, &500u32);
+        if pt_side <= 0 {
+            std::println!("{:<28} {:>14} {:>12}", label, "uncalibratable", "-");
+            continue;
+        }
+        seed_pool(&w, pt_side, usdc_side);
+        std::println!(
+            "{:<28} {:>13.2}:1 {:>12.5}",
+            label,
+            pt_side as f64 / usdc_side as f64,
+            w.market().pt_price() as f64 / 1e12
+        );
+    }
+    std::println!("\n  Same 5% target rate. The par anchor is what costs 7x the capital.");
+}
+
+/// **The catch.** A static below-par anchor buys cheap seeding but BREAKS par convergence: as
+/// `t -> 0` the curve flattens onto `rate_anchor`, so PT converges to the anchor, not to 1.0.
+/// PT redeems at 1.0 regardless, so the pool would quote PT below its redemption value right up to
+/// maturity — a standing risk-free draw on LPs.
+///
+/// Pendle avoids the trade-off by RE-ANCHORING on every state update (`_getRateAnchor` recomputes
+/// the anchor from `lastLnImpliedRate`), which Spield does not do
+/// (`PHASE3_AMM_DESIGN.md` §3.4 calls it a "Stage C.1 refinement").
+#[test]
+fn a_below_par_static_anchor_breaks_par_convergence() {
+    const DAY: u64 = 24 * 60 * 60;
+    const SC12: i128 = 1_000_000_000_000;
+    for (label, anchor) in [("par 1.0000", SC12), ("0.9880", SC12 * 988 / 1000)] {
+        let w = setup_with_anchor(90 * DAY, anchor);
+        let usdc_side = 1_000_000 * USDC;
+        let pt_side = w.market().seed_pt_for_apy(&usdc_side, &500u32);
+        seed_pool(&w, pt_side, usdc_side);
+        std::print!("anchor {:<12}  PT price:", label);
+        for d in [0u64, 45, 80, 89] {
+            if d > 0 {
+                w.env.ledger().set_timestamp(w.env.ledger().timestamp() + 45 * DAY.min(d * DAY) / 45);
+            }
+            w.env.ledger().set_timestamp(1_700_000_000 + d * DAY);
+            std::print!("  d{:<3}={:.5}", d, w.market().pt_price() as f64 / 1e12);
+        }
+        std::println!();
+    }
+    std::println!("  A par anchor walks PT to 1.0. A 0.988 anchor walks it to 0.988 and STOPS there,");
+    std::println!("  while every PT still redeems at 1.0 -> free money out of the LPs at maturity.");
+}
