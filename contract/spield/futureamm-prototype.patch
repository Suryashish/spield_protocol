+    /// **Spec §8 — capital-efficient YT buy.** The *market* supplies `amount` USDC (its own
+    /// reserve contribution plus the user's), and the wrapper splits it into
+    /// `amount` PT minted **to the market** (pure bearer inventory, no position) and
+    /// `amount` YT minted **to `yt_recipient`**, recorded as a YT-only position they own.
+    ///
+    /// This is the leg the existing `mint` cannot express: `mint` always bundles PT+YT into one
+    /// position owned by one address.
+    pub fn split_for_market(env: Env, market: Address, yt_recipient: Address, amount: i128) -> u64 {
+        Self::ensure_can_deposit(&env);
+        Self::ensure_registered_market(&env, &market);
+        market.require_auth();
+        if amount <= 0 {
+            panic_with_error!(&env, Error::InvalidAmount);
+        }
+        if env.ledger().timestamp() >= storage::get_maturity(&env) {
+            panic_with_error!(&env, Error::MarketMatured);
+        }
+        let strategy_addr = storage::get_strategy(&env);
+        let strategy = YieldStrategyClient::new(&env, &strategy_addr);
+        let underlying = storage::get_underlying(&env);
+
+        // Pull the full notional from the MARKET (not the user) — this is what makes the trade
+        // capital-efficient for the user: they only ever funded the YT price into the market.
+        token::Client::new(&env, &underlying).transfer(
+            &market,
+            &env.current_contract_address(),
+            &amount,
+        );
+
+        let entry_rate = strategy.current_rate();
+        let min_mint = math::min_mintable(entry_rate);
+        if amount < min_mint {
+            panic_with_error!(&env, Error::InvalidAmount);
+        }
+        Self::approve_strategy_pull(&env, &underlying, &strategy_addr, amount);
+        let shares = strategy.deposit(&env.current_contract_address(), &amount);
+        if shares <= 0 {
+            panic_with_error!(&env, Error::SolvencyViolation);
+        }
+
+        // The two legs go to two different addresses — the whole point of this entrypoint.
+        Self::pt_admin(&env).mint(&market, &amount);
+        Self::yt_admin(&env).mint(&yt_recipient, &amount);
+
+        // A YT-ONLY position: `pt_amount = 0` because the PT left as bearer inventory.
+        let id = storage::next_position_id(&env);
+        let pos = Position {
+            owner: yt_recipient.clone(),
+            principal: amount,
+            pt_amount: 0,
+            yt_amount: amount,
+            entry_rate,
+            settled_rate: entry_rate,
+            shares,
+            open: true,
+        };
