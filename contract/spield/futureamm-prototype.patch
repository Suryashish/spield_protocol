+/// Spec §12.14: a raw SAC transfer of YT must NOT carry the yield claim. The position ledger is
+/// authoritative, so the recipient gets tokens and no claim — and the sender keeps a claim they
+/// can no longer back. This is the known stranding hazard (tofix.md #15), and it is unchanged —
+/// in fact WIDENED — by market-issued YT.
+#[test]
+fn a_raw_yt_transfer_still_strands_the_claim_and_the_market_path_does_not_fix_it() {
+    let w = setup(YEAR);
+    deep_pool(&w);
+    let n = 10_000 * USDC;
+    let (user_in, _) = w.market().quote_buy_yt_exact_out(&n);
+    let alice = w.new_user(user_in);
+    let pid = w.wrapper().next_position_id();
+    w.market().buy_yt_exact_out(&alice, &n, &user_in, &0u32);
+
+    let bob = Address::generate(&w.env);
+    w.yt().transfer(&alice, &bob, &n);
+    assert_eq!(w.yt().balance(&bob), n);
+    assert_eq!(w.yt().balance(&alice), 0);
+
+    w.advance(90 * 24 * 60 * 60);
+    w.env.cost_estimate().budget().reset_unlimited();
+    // Alice holds ZERO YT and still collects every stroop of the yield.
+    let paid = w.wrapper().claim_yield(&pid);
+    assert!(paid > 0, "the ledger, not the token, is the claim");
+    assert_eq!(w.usdc().balance(&bob), 0, "Bob's YT is inert");
+    std::println!(
+        "Alice transferred away all {} YT and still claimed {:.4} USDC; Bob claimed 0",
+        n / USDC,
+        paid as f64 / USDC as f64
+    );
+
+    // Worse for the sale path: Alice can still sell YT she no longer holds, because the merge
+    // burns from `pos.owner` — which now fails on balance, so the sale reverts and she is stuck.
+    let (q, _) = w.market().quote_sell_yt_exact_in(&n);
+    assert!(w
+        .market()
+        .try_sell_yt_exact_in(&alice, &pid, &n, &q, &0u32)
+        .is_err(), "no YT to burn");
+}
