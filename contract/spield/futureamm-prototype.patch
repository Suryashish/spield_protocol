+    /// **Spec §8 — buy exactly `yt_out` YT.** The user funds only `yt_out - pool_contribution`;
+    /// the pool funds the rest and atomically receives `yt_out` newly minted PT.
+    ///
+    /// Economically this is *one ordinary swap*: the pool bought `yt_out` PT for
+    /// `pool_contribution` USDC. Reserves move exactly as `swap_exact_pt_for_usdc(yt_out)` would.
+    /// Returns the USDC the user actually paid.
+    pub fn buy_yt_exact_out(
+        env: Env,
+        user: Address,
+        yt_out: i128,
+        max_usdc_in: i128,
+        deadline_ledger: u32,
+    ) -> i128 {
