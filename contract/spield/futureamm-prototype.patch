+    let w = setup(YEAR);
+    deep_pool(&w);
+    let n = 10_000 * USDC;
+    let (user_in, _) = w.market().quote_buy_yt_exact_out(&n);
+    let u = w.new_user(user_in);
+    let env = &w.env;
+
+    // ONLY the user signs, and only for the transfer they actually make. The market must supply
+    // the auth for the full-notional pull into the wrapper out of its own contract authority.
+    env.mock_auths(&[MockAuth {
+        address: &u,
+        invoke: &MockAuthInvoke {
+            contract: &w.market,
+            fn_name: "buy_yt_exact_out",
+            args: (u.clone(), n, user_in, 0u32).into_val(env),
+            sub_invokes: &[MockAuthInvoke {
+                contract: &w.usdc,
+                fn_name: "transfer",
+                args: (u.clone(), w.market.clone(), user_in).into_val(env),
+                sub_invokes: &[],
+            }],
+        },
+    }]);
+    let paid = w.market().buy_yt_exact_out(&u, &n, &user_in, &0u32);
+    assert_eq!(paid, user_in);
+    assert_eq!(w.yt().balance(&u), n);
+}
