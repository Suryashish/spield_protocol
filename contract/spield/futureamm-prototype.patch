+/// The viability boundary: the swap fee is levied on the NOTIONAL, but the YT buyer only pays
+/// `1 - PT_price` of it. So the fee the YT trader actually feels is `leverage x fee_bps`.
+/// Below some implied APY the fee exceeds the entire value of the YT and the market dies.
+#[test]
+fn below_a_minimum_implied_apy_the_notional_fee_exceeds_the_whole_yt_value() {
+    for apy_bps in [50u32, 100, 200, 400, 800, 1500] {
+        let w = setup(YEAR);
+        let usdc_side = 1_000_000 * USDC;
+        let pt_side = w.market().seed_pt_for_apy(&usdc_side, &apy_bps);
+        if pt_side <= 0 || pt_side > 20_000_000 * USDC {
+            std::println!("{:>5} bps: needs a {:.0}x PT-heavy pool — out of test range", apy_bps, pt_side as f64 / usdc_side as f64);
+            continue;
+        }
+        seed_pool(&w, pt_side, usdc_side);
+        let n = 10_000 * USDC;
+        let (user_in, _) = w.market().quote_buy_yt_exact_out(&n);
+        let (sell_out, _) = w.market().quote_sell_yt_exact_in(&n);
+        if user_in == 0 {
+            std::println!("{:>5} bps: YT UNBUYABLE", apy_bps);
+            continue;
+        }
+        let lev = n as f64 / user_in as f64;
+        std::println!(
+            "{:>5} bps APY | PT {:.4} | YT costs {:>9.3} ({:>6.1}x) | instant resale {:>9.3} | round-trip cost {:>5.1}% of the YT price{}",
+            apy_bps,
+            w.market().pt_price() as f64 / 1e12,
+            user_in as f64 / USDC as f64,
+            lev,
+            sell_out as f64 / USDC as f64,
+            (user_in - sell_out) as f64 * 100.0 / user_in as f64,
+            if sell_out == 0 { "   <-- UNSELLABLE" } else { "" }
+        );
+    }
+}
