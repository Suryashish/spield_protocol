+// --- auth, for real (not mock_all_auths) ------------------------------------
+//
+// The FEATUREPLAN's flash-lend design flagged the Soroban callback/auth shape as its one
+// UNVALIDATED piece (§6.2). This design has no callback, but it does rely on the market
+// authorizing a nested `usdc.transfer(market -> wrapper)` on its own behalf. These tests take
+// `mock_all_auths` away and prove the plumbing under enforced authorization.
+
+#[test]
+fn buy_yt_works_with_only_the_users_signature() {
+    use soroban_sdk::testutils::{MockAuth, MockAuthInvoke};
+    use soroban_sdk::IntoVal;
