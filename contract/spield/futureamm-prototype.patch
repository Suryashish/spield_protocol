+/// A deep pool seeded PT-heavy so PT trades at a real discount (positive implied APY), which is
+/// the only regime where YT has any value to buy.
+fn deep_pool(w: &World) -> (Address, i128) {
+    // Seed via the contract's OWN calibration so the pool opens at a realistic 8% implied APY —
+    // a 1.2:1 hand-picked ratio opens at ~0.5%, which is not a regime where YT exists at all.
+    let usdc_side = 1_000_000 * USDC;
+    let pt_side = w.market().seed_pt_for_apy(&usdc_side, &800u32);
+    assert!(pt_side > 0, "calibration failed");
+    seed_pool(w, pt_side, usdc_side)
+}
