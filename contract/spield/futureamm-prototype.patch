+    /// **Spec §9 — sell `yt_in` YT out of `position_id`.** The pool contributes matching PT, the
+    /// wrapper checkpoints the seller's accrued yield and burns both legs, and the released
+    /// principal is split: the pool retains the PT's market value, the seller receives the rest.
+    ///
+    /// Returns `(usdc_paid_to_seller, yield_claimed)`.
+    pub fn sell_yt_exact_in(
+        env: Env,
+        user: Address,
+        position_id: u64,
+        yt_in: i128,
+        min_usdc_out: i128,
+        deadline_ledger: u32,
+    ) -> (i128, i128) {
+        Self::ensure_can_trade(&env);
+        Self::ensure_tradeable(&env);
+        Self::ensure_deadline(&env, deadline_ledger);
+        user.require_auth();
+        if yt_in <= 0 {
+            panic_with_error!(&env, Error::InvalidAmount);
+        }
+
+        let pt_res = storage::pt_reserve(&env);
+        let usdc_res = storage::usdc_reserve(&env);
+        let fee = storage::get_fee_bps(&env);
+        let params = Self::curve_params(&env);
+        let retained =
