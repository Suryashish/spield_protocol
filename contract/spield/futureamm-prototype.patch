+    /// **Spec §9 — YT sale.** The market contributes `amount` PT from its reserve; the wrapper
+    /// checkpoints the seller's yield on the OLD amount (spec §4.5), burns both legs, and pays the
+    /// released `amount` USDC of principal to the market, which then splits it between its own
+    /// retained PT value and the seller's YT proceeds.
+    ///
+    /// Returns `(principal_released_to_market, yield_claimed_for_seller)`.
+    pub fn merge_for_yt_sale(
+        env: Env,
+        market: Address,
+        position_id: u64,
+        amount: i128,
+    ) -> (i128, i128) {
+        Self::ensure_initialized(&env); // an exit — open while paused
+        Self::ensure_registered_market(&env, &market);
+        market.require_auth();
+        if amount <= 0 {
+            panic_with_error!(&env, Error::InvalidAmount);
+        }
+        let mut pos = Self::load(&env, position_id);
+        pos.owner.require_auth();
+        if !pos.open {
+            panic_with_error!(&env, Error::PositionClosed);
+        }
+        // PROTOTYPE GUARD: only YT-only positions may be merged this way. A bundled PT+YT position
